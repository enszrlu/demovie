{
  "name": "demovie",
  "version": "0.1.1",
  "type": "module",
  "description": "Accurate, on-brand motion-graphics videos of your real web app, made by your AI coding agent. Your agent animates. demovie makes it true.",
  "license": "MIT",
  "homepage": "https://github.com/enszrlu/demovie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enszrlu/demovie.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/enszrlu/demovie/issues",
  "keywords": [
    "video",
    "product-video",
    "launch-video",
    "demo-video",
    "changelog",
    "motion-graphics",
    "ai-video",
    "nextjs",
    "agent-skills",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "playwright",
    "gsap"
  ],
  "bin": {
    "demovie": "./dist/index.js"
  },
  "exports": {
    "./flow": {
      "types": "./dist/flow.d.ts",
      "default": "./dist/flow.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "schema",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsdown && tsx scripts/build-assets.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "acorn": "^8.18.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "esbuild": "^0.28.2",
    "execa": "^9.6.1",
    "get-port": "^7.2.0",
    "gsap": "^3.15.0",
    "picocolors": "^1.1.1",
    "pixelmatch": "^7.2.0",
    "playwright-core": "1.60.0",
    "pngjs": "^7.0.0",
    "tree-kill": "^1.2.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@demovie/action": "workspace:*",
    "@demovie/audio": "workspace:*",
    "@demovie/capture": "workspace:*",
    "@demovie/core": "workspace:*",
    "@demovie/mcp": "workspace:*",
    "@demovie/qa": "workspace:*",
    "@demovie/render": "workspace:*",
    "@demovie/runtime": "workspace:*",
    "@demovie/skill": "workspace:*"
  }
}
