{
  "name": "@demovie/runtime",
  "version": "0.1.1",
  "type": "module",
  "description": "Browser runtime for demovie compositions: deterministic time, device frames, camera moves to real elements, a truthful cursor, captions and transitions.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/enszrlu/demovie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enszrlu/demovie.git",
    "directory": "packages/runtime"
  },
  "bugs": "https://github.com/enszrlu/demovie/issues",
  "keywords": [
    "demovie",
    "video",
    "motion-graphics",
    "gsap",
    "product-video"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/runtime.js"
    },
    "./clock": {
      "types": "./dist/types/clock.d.ts",
      "default": "./dist/clock.js"
    },
    "./runtime.css": "./dist/runtime.css",
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "fonts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx build.ts",
    "vendor-fonts": "tsx scripts/vendor-fonts.ts"
  },
  "peerDependencies": {
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "esbuild": "^0.28.2",
    "geist": "1.7.2",
    "gsap": "^3.15.0"
  }
}
