{
  "name": "@demovie/runtime",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser runtime for demovie compositions: deterministic time, device frames, camera moves to real elements, a truthful cursor, captions and transitions.",
  "license": "MIT",
  "keywords": [
    "demovie",
    "video",
    "motion-graphics",
    "gsap",
    "product-video"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/runtime.js"
    },
    "./clock": "./dist/clock.js",
    "./runtime.css": "./dist/runtime.css",
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx build.ts"
  },
  "peerDependencies": {
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0"
  }
}
