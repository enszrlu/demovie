# demovie project state that is never committed (mirrors the generated .demovie/.gitignore)
**/.demovie/.env
**/.demovie/.auth/
**/.demovie/.cache/
**/.demovie/captures/
**/.demovie/videos/*/out/
**/.demovie/videos/*/qa.json
examples/compositions/*/out/
examples/compositions/*/qa.json
# reference compositions' generated audio (deterministic; `pnpm verify` regenerates it)
examples/compositions/*/audio/*.wav
!examples/compositions/bad-audio/audio/*.wav

# skill copies installed into the fixture by `demovie skill install` / `make` (source: packages/skill/demovie)
examples/harborly/.claude/
examples/harborly/.agents/

# generated into the demovie package at build time
packages/cli/schema/
packages/cli/assets/
packages/cli/skill/
packages/cli/LICENSE
